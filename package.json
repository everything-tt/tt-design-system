{
  "name": "@everything-tt/tt-players-design-system",
  "version": "0.1.24",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "tt-design-system": "./scripts/install-agent-skill.mjs"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node ./scripts/prepare-package.mjs",
    "test": "vitest run",
    "pack:check": "pnpm run build && npm pack ./dist --dry-run",
    "smoke:consumer": "node ./scripts/consumer-smoke.mjs",
    "postinstall": "node ./scripts/install-agent-skill.mjs --auto",
    "demo": "pnpm --filter @everything-tt/tt-players-design-system-demo dev",
    "demo:build": "pnpm --filter @everything-tt/tt-players-design-system-demo build",
    "demo:typecheck": "pnpm --filter @everything-tt/tt-players-design-system-demo typecheck"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "vite-plugin-pwa": {
      "optional": true
    },
    "workbox-window": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.4",
    "workbox-window": "^7.4.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./primitives": "./src/components/ui/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./utils": "./src/lib/utils.ts",
    "./pwa": "./src/pwa/index.ts",
    "./pwa/vite": "./src/pwa/vite.ts"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "tailwind-merge": "^3.3.1"
  }
}
